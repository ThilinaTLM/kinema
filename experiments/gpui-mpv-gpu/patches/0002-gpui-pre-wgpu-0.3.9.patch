+#[cfg(all(test, target_os = "linux", feature = "gpu-video-experiment"))]
+mod gpu_surface_tests {
+    use super::*;
+    use gpui::{ContentMask, GpuSurfaceFrame, PaintSurface, point, size};
+
+    /// Synthetic validation ONLY: CPU upload and readback are not playback paths.
+    #[test]
+    #[ignore = "requires a Vulkan GPU; explicitly runs test-only pixel upload/readback"]
+    fn synthetic_rgba_surface_clips_and_blends() -> anyhow::Result<()> {
+        let mut renderer = WgpuHeadlessRenderer::new()?;
+        anyhow::ensure!(renderer.context.adapter.get_info().backend == wgpu::Backend::Vulkan);
+        let device = &renderer.context.device;
+        let texture = device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("synthetic_gpu_surface_test_only"),
+            size: wgpu::Extent3d {
+                width: 2,
+                height: 2,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba8Unorm,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+            view_formats: &[],
+        });
+        assert!(
+            GpuSurfaceFrame::new(
+                texture.create_view(&Default::default()),
+                [0, 2],
+                Arc::new(())
+            )
+            .is_err()
+        );
+        assert!(
+            GpuSurfaceFrame::new(
+                texture.create_view(&Default::default()),
+                [2, 3],
+                Arc::new(())
+            )
+            .is_err()
+        );
+        // Deliberately zero source alpha: the probe contract is opaque RGB.
+        renderer.context.queue.write_texture(
+            texture.as_image_copy(),
+            &[255, 0, 0, 0].repeat(4),
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(8),
+                rows_per_image: Some(2),
+            },
+            texture.size(),
+        );
+        let owner = Arc::new(());
+        let owner_weak = Arc::downgrade(&owner);
+        let frame = Arc::new(
+            GpuSurfaceFrame::new(
+                texture.create_view(&Default::default()),
+                [2, 2],
+                owner.clone(),
+            )
+            .map_err(anyhow::Error::msg)?,
+        );
+        drop(owner);
+        let mut scene = Scene::default();
+        scene.insert_primitive(PaintSurface {
+            order: 0,
+            bounds: Bounds {
+                origin: point(ScaledPixels(1.0), ScaledPixels(1.0)),
+                size: size(ScaledPixels(6.0), ScaledPixels(6.0)),
+            },
+            content_mask: ContentMask {
+                bounds: Bounds {
+                    origin: point(ScaledPixels(2.0), ScaledPixels(3.0)),
+                    size: size(ScaledPixels(3.0), ScaledPixels(2.0)),
+                },
+            },
+            gpu_frame: frame,
+            opacity: 0.5,
+        });
+        scene.finish();
+        assert!(owner_weak.upgrade().is_some());
+        renderer.render(&scene, size(DevicePixels(8), DevicePixels(8)))?;
+        let image = renderer.read_image()?; // Explicit test-only CPU readback.
+        for y in 0..8 {
+            for x in 0..8 {
+                let pixel = image.get_pixel(x, y).0;
+                if (2..5).contains(&x) && (3..5).contains(&y) {
+                    assert!((127..=129).contains(&pixel[0]), "{x},{y}: {pixel:?}");
+                    assert_eq!(&pixel[1..3], &[0, 0]);
+                } else {
+                    assert_eq!(&pixel[..3], &[0, 0, 0], "{x},{y}: {pixel:?}");
+                }
+            }
+        }
+        drop(scene);
+        assert!(owner_weak.upgrade().is_none());
+        Ok(())
