+#[cfg(all(target_os = "linux", feature = "gpu-video-experiment"))]
+pub fn gpu_surface(frame: std::sync::Arc<GpuSurfaceFrame>) -> Surface {
+    Surface {
+        source: SurfaceSource::Gpu(frame),
+        object_fit: ObjectFit::Contain,
+        style: Default::default(),
+    }
+}
