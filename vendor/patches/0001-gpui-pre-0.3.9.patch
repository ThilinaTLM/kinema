+    /// Paint an immutable GPU frame using normal scene ordering and clipping.
+    /// This does not wait for GPU completion or actual presentation.
+    #[cfg(all(
+        any(target_os = "linux", target_os = "windows", target_os = "macos"),
+        feature = "gpu-video-experiment"
+    ))]
+    pub fn paint_gpu_surface(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        frame: Arc<crate::GpuSurfaceFrame>,
+    ) {
+        self.invalidator.debug_assert_paint();
+        let bounds = self.snap_bounds(bounds);
+        let content_mask = self.snapped_content_mask();
+        let opacity = self.element_opacity();
+        self.next_frame.scene.insert_primitive(crate::PaintSurface {
+            order: 0,
+            bounds,
+            content_mask,
+            #[cfg(any(target_os = "linux", target_os = "windows"))]
+            gpu_frame: frame,
+            #[cfg(target_os = "macos")]
+            image_buffer: frame.pixel_buffer().clone(),
+            #[cfg(target_os = "macos")]
+            gpu_frame: Some(frame),
+            opacity,
         });
     }
