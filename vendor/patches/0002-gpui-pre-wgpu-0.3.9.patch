+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+pub fn experimental_gpu_context() -> Option<WgpuContext> {
+    active_experimental_context()
+        .ok()
+        .flatten()
+        .map(|record| (*record.context).clone())
+}
