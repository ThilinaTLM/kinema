+/// External synchronization gate shared by EVERY window on the actual device.
+/// None when the live device lookup is absent/ambiguous. Producer waits/polls and
+/// command recording stay outside it. Submit/present scopes are short; existing
+/// framework configure/drop retains the gate across device-idle waits, including
+/// UI-thread resize/teardown. A poisoned gate is fatal: never bypass it.
+/// Reacquire context AND gate on the UI lifecycle thread after recovery. This is
+/// not a GPU memory dependency, cross-API fence, or actual-presentation fence.
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+pub fn experimental_gpu_queue_gate() -> Option<Arc<std::sync::Mutex<()>>> {
+    active_experimental_context()
+        .ok()
+        .flatten()
+        .map(|record| record.queue_gate.clone())
+}
