+// Keep configure and EVERY configured-surface drop on the same gate as raw
+// producer submits. HAL reconfiguration/unconfiguration calls vkDeviceWaitIdle,
+// which externally synchronizes every queue, including the producer's raw queue.
+// The wrapper covers normal Drop, destroy, unconfigure, replacement, recovery,
+// and error unwinding without relying on each caller remembering teardown locks.
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+struct WgpuWindowSurface {
+    surface: Option<wgpu::Surface<'static>>,
+    queue_gate: Arc<std::sync::Mutex<()>>,
+}
+
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+impl WgpuWindowSurface {
+    fn new(surface: wgpu::Surface<'static>, queue_gate: Arc<std::sync::Mutex<()>>) -> Self {
+        Self {
+            surface: Some(surface),
+            queue_gate,
+        }
+    }
+
+    fn configure(&self, device: &wgpu::Device, config: &wgpu::SurfaceConfiguration) {
+        let _queue_gate = self
+            .queue_gate
+            .lock()
+            .expect("experimental GPU queue gate poisoned");
+        // Existing framework wait exception: configure can block on GPU idle
+        // while resizing. It MUST exclude producer submits for the entire call.
+        self.surface
+            .as_ref()
+            .expect("live window surface")
+            .configure(device, config);
+    }
+}
+
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+impl std::ops::Deref for WgpuWindowSurface {
+    type Target = wgpu::Surface<'static>;
+
+    fn deref(&self) -> &Self::Target {
+        self.surface.as_ref().expect("live window surface")
+    }
+}
+
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+impl Drop for WgpuWindowSurface {
+    fn drop(&mut self) {
+        let _queue_gate = self
+            .queue_gate
+            .lock()
+            .expect("experimental GPU queue gate poisoned");
+        // Take before dropping: automatic field destruction must not unconfigure
+        // the swapchain after this guard is released.
+        drop(self.surface.take());
+    }
+}
