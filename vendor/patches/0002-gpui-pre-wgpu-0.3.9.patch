 use std::rc::Rc;
 use std::sync::Arc;
 
+// Weak per-device records: callers holding returned context/gate clones do not
+// keep a renderer registration alive. All windows on one actual device share the
+// same Arc<WgpuContext> and external synchronization gate.
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+static EXPERIMENTAL_CONTEXTS: parking_lot::Mutex<Vec<std::sync::Weak<ExperimentalGpuContext>>> =
+    parking_lot::Mutex::new(Vec::new());
+
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+struct ExperimentalGpuContext {
+    context: Arc<WgpuContext>,
+    queue_gate: Arc<std::sync::Mutex<()>>,
+}
+
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+fn register_experimental_context(
+    context: &WgpuContext,
+    shared: Option<Arc<WgpuContext>>,
+) -> anyhow::Result<Arc<ExperimentalGpuContext>> {
+    let mut contexts = EXPERIMENTAL_CONTEXTS.lock();
+    contexts.retain(|record| record.strong_count() > 0);
+    for record in contexts.iter().filter_map(std::sync::Weak::upgrade) {
+        // Device's Eq compares the actual wgpu dispatch identity, including when
+        // a caller wraps a cloned Device handle in another outer Arc.
+        if record.context.device == context.device {
+            anyhow::ensure!(
+                record.context.queue == context.queue,
+                "same-device experiment contexts must use the same queue"
+            );
+            return Ok(record);
+        }
+    }
+    let record = Arc::new(ExperimentalGpuContext {
+        context: shared.unwrap_or_else(|| Arc::new(context.clone())),
+        queue_gate: context.experimental_queue_gate.clone(),
+    });
+    // Publish only after surface configuration and core creation succeed.
+    Ok(record)
+}
+
+#[cfg(all(
+    any(target_os = "linux", target_os = "windows"),
+    feature = "gpu-video-experiment"
+))]
+fn active_experimental_context() -> anyhow::Result<Option<Arc<ExperimentalGpuContext>>> {
+    let mut contexts = EXPERIMENTAL_CONTEXTS.lock();
+    contexts.retain(|record| record.strong_count() > 0);
+    let mut unique: Option<Arc<ExperimentalGpuContext>> = None;
+    for record in contexts
+        .iter()
+        .filter_map(std::sync::Weak::upgrade)
+        .filter(|record| !record.context.device_lost())
+    {
+        if let Some(previous) = &unique {
+            anyhow::ensure!(
+                previous.context.device == record.context.device,
+                "multiple live GPU devices make the experiment context ambiguous"
+            );
+        }
+        unique = Some(record);
+    }
+    Ok(unique)
+}
+
+/// The actual device shared by live window renderers, if unambiguous.
+/// None before window renderer creation, after all registrations are released or
+/// lost, or when multiple live devices exist. Returned clones are not leases on
