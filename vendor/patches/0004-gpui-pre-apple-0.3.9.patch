 use parking_lot::Mutex;
 
 use std::{cell::Cell, ffi::c_void, mem, mem::MaybeUninit, ops::Range, ptr, slice, sync::Arc};
+
+// Weak registrations are owned only by live window renderers, never accessors
+// or a guessed/default Metal device. Multiple windows on one registry ID work;
+// multiple active GPU IDs make the public lookup fail closed.
+#[cfg(all(target_os = "macos", feature = "gpu-video-experiment"))]
+static EXPERIMENTAL_METAL_DEVICES: Mutex<Vec<std::sync::Weak<ExperimentalMetalDevice>>> =
+    Mutex::new(Vec::new());
+
+#[cfg(all(target_os = "macos", feature = "gpu-video-experiment"))]
+struct ExperimentalMetalDevice {
+    registry_id: u64,
+}
+
+#[cfg(all(target_os = "macos", feature = "gpu-video-experiment"))]
+fn register_experimental_device(device: &metal::DeviceRef) -> Arc<ExperimentalMetalDevice> {
+    let record = Arc::new(ExperimentalMetalDevice {
+        registry_id: device.registry_id(),
+    });
+    let mut devices = EXPERIMENTAL_METAL_DEVICES.lock();
+    devices.retain(|record| record.strong_count() > 0);
+    devices.push(Arc::downgrade(&record));
+    record
+}
+
+/// Actual live GPUI window renderer Metal device registry ID, only when unique.
+/// None before renderer creation, after destroy/drop, for zero IDs, or while
+/// live renderers use different GPUs. Not a default-device guess or lifetime lease.
+#[cfg(all(target_os = "macos", feature = "gpu-video-experiment"))]
+pub fn experimental_gpu_registry_id() -> Option<u64> {
+    let mut devices = EXPERIMENTAL_METAL_DEVICES.lock();
+    devices.retain(|record| record.strong_count() > 0);
+    unique_live_registry_id(&devices)
+}
+
+#[cfg(all(target_os = "macos", feature = "gpu-video-experiment"))]
+fn unique_live_registry_id(devices: &[std::sync::Weak<ExperimentalMetalDevice>]) -> Option<u64> {
+    let mut unique = None;
+    for device in devices.iter().filter_map(std::sync::Weak::upgrade) {
+        if device.registry_id == 0 || unique.is_some_and(|id| id != device.registry_id) {
+            return None;
+        }
+        unique = Some(device.registry_id);
+    }
+    unique
+}
 
