+#ifdef GPUI_GPU_VIDEO_EXPERIMENT
+// Experimental opaque BGRA32 SDR surface. Logical RGBA sampling of a BGRA8Unorm
+// Metal texture requires no channel swizzle. The existing surface_vertex retains
+// object-fit geometry and hardware rectangular clip distances; NV12 is unchanged.
+fragment float4 surface_bgra_fragment(
+    SurfaceFragmentInput input [[stage_in]],
+    texture2d<float> image [[texture(SurfaceInputIndex_YTexture)]],
+    constant float &opacity [[buffer(0)]]) {
+  constexpr sampler texture_sampler(mag_filter::linear, min_filter::linear);
+  float3 rgb = image.sample(texture_sampler, input.texture_position).rgb;
+  return float4(rgb, clamp(opacity, 0.0f, 1.0f));
+}
+
+#endif // GPUI_GPU_VIDEO_EXPERIMENT
