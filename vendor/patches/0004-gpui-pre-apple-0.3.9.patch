+#[cfg(all(test, target_os = "macos", feature = "gpu-video-experiment"))]
+mod experimental_registry_tests {
+    use super::*;
+    #[test]
+    fn registry_lookup_is_unique_and_never_owns_a_renderer() {
+        let first = Arc::new(ExperimentalMetalDevice { registry_id: 11 });
+        let same = Arc::new(ExperimentalMetalDevice { registry_id: 11 });
+        let different = Arc::new(ExperimentalMetalDevice { registry_id: 12 });
+        let mut devices = vec![Arc::downgrade(&first), Arc::downgrade(&same)];
+        assert_eq!(unique_live_registry_id(&devices), Some(11));
+        devices.push(Arc::downgrade(&different));
+        assert_eq!(unique_live_registry_id(&devices), None);
+        drop(different);
+        assert_eq!(unique_live_registry_id(&devices), Some(11));
+        drop(first);
+        drop(same);
+        assert_eq!(unique_live_registry_id(&devices), None);
+        let zero = Arc::new(ExperimentalMetalDevice { registry_id: 0 });
+        assert_eq!(unique_live_registry_id(&[Arc::downgrade(&zero)]), None);
+    }
+}
